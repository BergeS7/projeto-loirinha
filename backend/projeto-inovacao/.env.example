# Copie para .env (que NAO e versionado) e ajuste.
# Dev local (emulador) e o padrao. Producao exige passos extras explicitos.

# "emulator" (padrao) ou "production"
APP_ENV=emulator

# Emulador: use um ID "demo-*" (o emulador nunca toca em projeto real).
# Producao: ID real do projeto Firebase.
FIREBASE_PROJECT_ID=demo-loirinha

# Obrigatorio em APP_ENV=emulator; PROIBIDO em APP_ENV=production.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# So em APP_ENV=production: caminho (fora do repo) do JSON da Service Account.
# O conteudo do JSON NUNCA vai no codigo nem no Git.
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/seguro/fora/do/repo/service-account.json
