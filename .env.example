# Copie este arquivo para .env.local e ajuste os valores.
# Variáveis com prefixo VITE_ ficam visíveis no navegador: nunca coloque segredos nelas.

# Fonte de dados: "mock" (dados simulados, padrão) ou "api" (backend real).
VITE_DATA_SOURCE=mock

# URL base da API. Pode ser absoluta (https://api.exemplo.com/v1) ou relativa (/api).
VITE_API_URL=/api

# Tempo máximo de cada requisição, em milissegundos.
VITE_API_TIMEOUT_MS=10000

# Só em desenvolvimento: encaminha /api para este endereço (evita CORS).
# Ex.: com o backend em http://localhost:3000, a chamada /api/linhas vai para http://localhost:3000/linhas
API_PROXY_TARGET=http://localhost:3000
