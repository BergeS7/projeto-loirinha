# Copie este arquivo para .env.local e ajuste os valores.
# Variáveis com prefixo VITE_ ficam visíveis no navegador: nunca coloque segredos nelas.

# Fonte de dados: "mock" (dados simulados, padrão) ou "api" (backend real).
VITE_DATA_SOURCE=mock

# URL base da API. Pode ser absoluta (https://api.exemplo.com/v1) ou relativa (/api).
VITE_API_URL=/api

# Tempo máximo de cada requisição, em milissegundos.
VITE_API_TIMEOUT_MS=10000

# Só em desenvolvimento: encaminha /api para este endereço (evita CORS).
# Ex.: com o backend em http://localhost:3000, a chamada /api/linhas vai para http://localhost:3000/linhas
API_PROXY_TARGET=http://localhost:3000

# ---------------------------------------------------------------------------
# Backend Firebase (pasta backend/). Usado por src/config/firebase.ts.
# Valores para os EMULADORES locais (docs/backend/BACKEND.md, seção 5).
# A chave é irrelevante no emulador: nunca coloque a chave de produção aqui.
# ---------------------------------------------------------------------------
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=fake-api-key-local
VITE_FIREBASE_PROJECT_ID=loirinha-1a25f
VITE_FIREBASE_DATABASE_URL=https://loirinha-1a25f-default-rtdb.firebaseio.com
VITE_FUNCTIONS_REGION=southamerica-east1
VITE_EMULATOR_HOST=127.0.0.1
VITE_AUTH_PORT=9099
VITE_FIRESTORE_PORT=8080
VITE_DATABASE_PORT=9000
VITE_FUNCTIONS_PORT=5001
